msgstr "Wasimamizi wa ukoo walioidhinishwa"

msgid "System administrators (for support and maintenance)"
msgstr "Wasimamizi wa mfumo (kwa usaidizi na matengenezo)"

msgid "Legal authorities (if required by law)"
msgstr "Mamlaka za kisheria (kama inavyotakiwa na sheria)"

